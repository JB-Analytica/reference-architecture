# Copy to .env (git-ignored) and fill in. GCP_PROJECT and GOOGLE_APPLICATION_CREDENTIALS are
# required and have no defaults, so a fresh clone cannot quietly write to somebody else's project.
#
# dbt 1.12 reads this file directly, as well as the refarch CLI, so one copy serves both.

# Path to a GCP service-account JSON key with BigQuery Job User + Data Editor on the project.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# BigQuery project and location the whole stack runs in. Required -- there is no default.
GCP_PROJECT=your-gcp-project
BIGQUERY_LOCATION=EU

# dbt target: dev writes to refarch_dev_* datasets, prod to refarch_*.
DBT_TARGET=dev

# Optional: Lightdash project UUID to deploy to. Leave unset until `refarch deploy --create` prints one.
# LIGHTDASH_PROJECT_UUID=
# Optional: Lightdash personal access token for CI (the local CLI uses ~/.config/lightdash instead).
# LIGHTDASH_API_KEY=
