# local config
.env

# python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# generated source system (deterministic: regenerate with `refarch generate`)
source_system/generated/

# the warehouse (rebuild it with `refarch run`)
warehouse/

# Evidence build artefacts (package-lock.json is committed, like uv.lock)
evidence/node_modules/
evidence/.evidence/
evidence/build/
evidence/static/data/

# dlt / dbt run artefacts
.dlt/pipelines/
.dlt/secrets.toml
dbt/target/
# dbt writes a local anonymous-user id here
dbt/.user.yml
dbt/dbt_packages/
dbt/logs/
logs/

# Local agent config — not part of the published example
.claude/
